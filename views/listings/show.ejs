<% layout("/layouts/boilerplate") %>

<link
  href="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.css"
  rel="stylesheet"
/>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-3 listing-card show-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="<%= listing.title %>"
    />

    <div class="card-body">
      <p class="card-text">
        Owned by
        <i>
          <%= listing.owner ? listing.owner.username : "Deleted user" %>
        </i>
        <br /><br />

        <%= listing.description %>
        <br /><br />

        &#8377;<%= listing.price.toLocaleString("en-IN") %>
        <br />

        <%= listing.location %>
        <br />

        <%= listing.country %>
      </p>
    </div>
  </div>

  <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
    <div class="btns col-6 offset-3 mt-3">
      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-dark me-2"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
        class="d-inline"
      >
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  <% } %>

  <div class="col-6 offset-3 mt-4">
    <hr />
    <h4>Where you'll be</h4>

    <div
      id="map"
      data-map-token="<%= mapToken %>"
      data-listing-coordinates='<%- JSON.stringify(listing.geometry ? listing.geometry.coordinates : null) %>'
      data-listing-title="<%= listing.title %>"
      data-listing-location="<%= listing.location %>, <%= listing.country %>"
    ></div>
  </div>

  <% if (currUser) { %>
    <div class="col-6 offset-3 mt-4">
      <hr />
      <h4>Add a review</h4>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
            required
          />
          <label for="first-rate1" title="Terrible">1 star</label>

          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>

          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>

          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>

          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>

          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please add some comments for the review.
          </div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
  <% } %>

  <div class="col-8 offset-2 mt-4 mb-5">
    <hr />
    <h4>All Reviews</h4>

    <div class="row">
      <% for (let review of listing.reviews) { %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5 class="card-title">
              @<%= review.author ? review.author.username : "Deleted user" %>
            </h5>

            <p
              class="starability-result card-text"
              data-rating="<%= review.rating %>"
            >
              Rated: <%= review.rating %> stars
            </p>

            <p class="card-text"><%= review.comment %></p>
          </div>

          <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
            <form
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              method="POST"
              class="mb-3 ms-3"
            >
              <button class="btn btn-sm btn-dark">Delete</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.js"></script>
<script src="/js/map.js"></script>