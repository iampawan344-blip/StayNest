<% layout("/layouts/boilerplate") %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .filter {
    text-align: center;
    margin-top: 2rem;
    opacity: 0.7;
    color: black;
    text-decoration: none;
  }

  .filter:hover,
  .filter.active {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    font-size: 0.8rem;
    margin: 0.25rem 0 0;
  }
</style>

<div id="filters">
  <a
    href="/listings"
    class="filter <%= selectedCategory === 'trending' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>

  <a
    href="/listings?category=rooms"
    class="filter <%= selectedCategory === 'rooms' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>

  <a
    href="/listings?category=mountains"
    class="filter <%= selectedCategory === 'mountains' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>

  <a
    href="/listings?category=iconic-city"
    class="filter <%= selectedCategory === 'iconic-city' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic City</p>
  </a>

  <a
    href="/listings?category=castles"
    class="filter <%= selectedCategory === 'castles' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>

  <a
    href="/listings?category=amazing-pool"
    class="filter <%= selectedCategory === 'amazing-pool' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pool</p>
  </a>

  <a
    href="/listings?category=camping"
    class="filter <%= selectedCategory === 'camping' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>

  <a
    href="/listings?category=farms"
    class="filter <%= selectedCategory === 'farms' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>

  <a
    href="/listings?category=farms"
    class="filter <%= selectedCategory === 'farms' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
    </a>

  <a
    href="/listings?category=farms"
    class="filter <%= selectedCategory === 'farms' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
    </a>
  <a
    href="/listings?category=arctic"
    class="filter <%= selectedCategory === 'arctic' ? 'active' : '' %>"
  >
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
</div>
<div class="tax-toggle">
  <label class="switch">
    <input type="checkbox" id="taxSwitch">
    <span class="slider"></span>
  </label>
  <span>Display Taxes</span>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="<%= listing.title %>"
        />

        <div class="card-img-overlay"></div>

        <div class="card-body">
      <p class="card-text">
  <b><%= listing.title %></b>
  <br />
  &#8377; <%= listing.price.toLocaleString("en-IN") %>/Night
  <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
</p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<% if (allListings.length === 0) { %>
  <p class="mt-4">No listings found in this category.</p>
<% } %>
<script>
  let taxSwitch = document.getElementById("taxSwitch");

  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.querySelectorAll(".tax-info");

    for (let info of taxInfo) {
      if (taxSwitch.checked) {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>